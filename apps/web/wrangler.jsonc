{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "firewood-web",
  "compatibility_date": "2026-06-16",
  "pages_build_output_dir": "./build/client",
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "env": {
    "preview": {
      "name": "firewood-web-preview",
      "ai": {
        "binding": "AI",
        "remote": true
      }
    },
    "production": {
      "name": "firewood-web",
      "ai": {
        "binding": "AI",
        "remote": true
      }
    }
  }
}