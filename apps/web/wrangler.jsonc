{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "firewood-web",
  // SvelteKit 的 adapter-cloudflare 把 Worker 和静态资源一起产出到 .svelte-kit/cloudflare
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-11-07",
  // SvelteKit 运行时要 node:async_hooks
  "compatibility_flags": ["nodejs_compat"],
  // 静态资源优先命中；命不中的请求才交给上面的 Worker 做 SSR
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // 公网端点的限流。namespace_id 在本 Worker 内唯一即可（不是账号级资源），
  // 配额是「每个实例分区计数」的近似值，用来压自动化滥用，不做精确计费。
  // 命中后端点返回 429，具体调用点见 src/lib/server/rateLimit.ts。
  "unsafe": {
    "bindings": [
      {
        // Workers AI 翻译，按 IP 每分钟 20 次
        "name": "RL_TRANSLATE",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 60 }
      },
      {
        // AutoRAG 搜索，单次开销大，按 IP 每分钟 10 次
        "name": "RL_SEARCH",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 10, "period": 60 }
      },
      {
        // 登录会真的发邮件出去，收得最紧：按 IP 每分钟 5 次
        "name": "RL_LOGIN",
        "type": "ratelimit",
        "namespace_id": "1003",
        "simple": { "limit": 5, "period": 60 }
      },
      {
        // 评论。匿名侧本就有 Turnstile，这里是登录用户也适用的兜底
        "name": "RL_COMMENT",
        "type": "ratelimit",
        "namespace_id": "1004",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  },
  "observability": {
    "enabled": true
  }
  // 运行时变量全部走 `wrangler secret put`（BASE_URL、IMG_PREFIX、SUPABASE_URL、
  // SUPABASE_ANON_KEY、MAPBOX_TOKEN、TURNSTILE_SITE_KEY、TURNSTILE_SECRET_KEY、
  // UNSUBSCRIBE_KEY），本地覆盖写 .dev.vars。仓库是公开的，所以不放 vars 里。
}
