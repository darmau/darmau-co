{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "firewood-cms",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-06-16",
	// SvelteKit 2.49 的 src/exports/internal/event.js 会 import node:async_hooks
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "darmau-co",
			"preview_bucket_name": "darmau-co",
			"remote": true
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	}
	// 原来有一个 env.development 块，内容和上面顶层配置逐字相同、连 name 都一样，
	// 只会让 wrangler 每次都警告"定义了多个环境但没指定目标"，并且 `deploy -e development`
	// 会打到同一个 Worker 上。已删除。
}
