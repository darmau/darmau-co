{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "firewood-gallery",
  // SvelteKit 的 adapter-cloudflare 把 Worker 和静态资源一起产出到 .svelte-kit/cloudflare
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-11-07",
  // SvelteKit 运行时要 node:async_hooks
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "gallery.darmau.co", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BASE_URL": "https://gallery.darmau.co",
    "IMG_PREFIX": "https://img.darmau.co",
    "SUPABASE_URL": "https://uvehzviuyezvgbwmghzk.supabase.co"
  }
  // 上面是不敏感的明文变量。必须写在这里：控制台里设的明文变量会被每次 wrangler deploy 覆盖掉。
  // SUPABASE_ANON_KEY / MAPBOX_TOKEN 走 `wrangler secret put`（secret 不会被部署覆盖），
  // 本地开发全部写 .dev.vars。
}
