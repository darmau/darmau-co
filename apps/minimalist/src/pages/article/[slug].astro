---
import Layout from "@/layouts/Layout.astro";
import { supabase } from "@/lib/supabase";
import ContentFormatter from "@/components/ContentFormatter.astro";

// 生成所有文章的静态路由
export async function getStaticPaths() {
  const { data: articles, error } = await supabase
    .from("article")
    .select("slug, language!inner (lang)")
    .eq("language.lang", "zh");

  if (error) {
    console.error("Error fetching articles for static paths:", error);
    return [];
  }

  return articles.map((article) => ({
    params: { slug: article.slug },
  }));
}

// 获取当前文章的slug
const { slug } = Astro.params;

// 从 Supabase 获取文章详情
const { data: article, error } = await supabase
  .from("article")
  .select(
    "id, title, subtitle, slug, abstract, published_at, is_premium,content_json, language!inner (lang), category!inner (title), cover!inner (storage_key)",
  )
  .eq("slug", slug)
  .eq("language.lang", "zh")
  .single();

if (error) {
  console.error("Error fetching article:", error);
  return Astro.redirect("/404");
}

if (!article) {
  return Astro.redirect("/404");
}

// 格式化发布时间
const publishedDate = new Date(article.published_at).toLocaleDateString(
  "zh-CN",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  },
);

const imgUrl = import.meta.env.IMG_PREFIX;

// 构建文章封面图片的完整 URL
const coverImageUrl = `${imgUrl}cdn-cgi/image/format=auto,quality=85,width=960,height=480/${article.cover.storage_key}`;
---

<Layout
  title={`${article.title} | 积薪(极简版)`}
  description={article.abstract || article.subtitle}
  url={`https://darmau.design/article/${slug}`}
  image={coverImageUrl}
  type="article"
>
  <main class="max-w-3xl mx-auto py-10 px-4 space-y-6">
    <h1 class="text-4xl font-medium text-slate-800">{article.title}</h1>
    <h2 class="text-xl text-slate-500">{article.subtitle}</h2>
    <div class="flex items-center gap-2">
      <p class="text-sm text-slate-500">{article.category.title}</p>
      <span class="text-slate-500">-</span>
      <time class="text-sm text-slate-500">{publishedDate}</time>
    </div>
    <div class="text-slate-600 bg-slate-50 rounded-lg p-4">
      {article.abstract}
    </div>
    <img
      class="w-full h-auto rounded-lg"
      src={coverImageUrl}
      alt={article.title}
    />
    {
      article.is_premium ? (
        <div class="text-center py-10 space-y-4">
          <p class="text-slate-700">本文需前往主站阅读</p>
          <a 
            href={`https://darmau.co/zh/article/${article.slug}`} 
            target="_blank" 
            class="bg-slate-700 text-white px-4 py-2 rounded-md inline-block"
            >
              查看原文
            </a>
        </div>
      ) : (
        <ContentFormatter content_json={article.content_json} />
      )
    }
  </main>
</Layout>
