---
import Layout from "@/layouts/Layout.astro";
import { supabase } from "@/lib/supabase";
import ArticleCard from "@/components/ArticleCard.astro";
import Pagination from "@/components/Pagination.astro";

const ITEMS_PER_PAGE = 20;

// 获取动态路由参数
export async function getStaticPaths() {
  const ITEMS_PER_PAGE = 20;
  // 先获取文章总数（使用与主查询相同的过滤条件）
  const { count, error: countError } = await supabase
    .from("article")
    .select("language!inner (lang)", { count: "exact", head: true })
    .eq("language.lang", "zh");

  if (countError) {
    console.error("Error fetching article count:", countError);
    // 如果获取总数失败，至少返回第一页
    return [{ params: { page: "1" } }];
  }

  const totalPages = Math.ceil((count || 0) / ITEMS_PER_PAGE);

  // 生成所有页面路由
  const paths = [];
  for (let i = 1; i <= totalPages; i++) {
    paths.push({ params: { page: i.toString() } });
  }

  // 如果没有文章，至少返回第一页
  if (paths.length === 0) {
    paths.push({ params: { page: "1" } });
  }

  return paths;
}

// 获取当前页码
const { page } = Astro.params;
const currentPage = parseInt(page || "1", 10);

// 从 Supabase 获取文章数据，根据page一页输出20条数据
const from = (currentPage - 1) * ITEMS_PER_PAGE;
const to = from + ITEMS_PER_PAGE - 1;

const { data: articles, error } = await supabase
  .from("article")
  // 根据lang字段去language表查询对应的language.lang
  .select(
    "title, subtitle, slug, published_at, is_premium, is_featured, language!inner (lang), category!inner (title)",
  )
  .eq("language.lang", "zh")
  .order("published_at", { ascending: false })
  .range(from, to);

// 获取总数（使用与主查询相同的过滤条件）
const { count: totalCount, error: countError } = await supabase
  .from("article")
  .select("language!inner (lang)", { count: "exact", head: true })
  .eq("language.lang", "zh");

if (error) {
  console.error("Error fetching articles:", error);
}

if (countError) {
  console.error("Error fetching article count:", countError);
}

const total = totalCount || 0;
const totalPages = Math.ceil(total / ITEMS_PER_PAGE);
---

<Layout>
  <main class="max-w-3xl mx-auto py-10 px-4">
    <h1 class="text-sm text-slate-500 mb-4">所有文章</h1>
    <ul class="flex flex-col gap-3">
      {articles && articles.map((article) => <ArticleCard {...article} />)}
    </ul>

    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      contextPath="articles"
    />
  </main>
</Layout>
