---
import HeroSection from "@/components/HeroSection.astro";
import Layout from "@/layouts/Layout.astro";
import { supabase } from "@/lib/supabase";

const ITEMS_PER_PAGE = 20;

// 获取动态路由参数
export async function getStaticPaths() {
  const ITEMS_PER_PAGE = 20;
  // 先获取文章总数（使用与主查询相同的过滤条件）
  const { count, error: countError } = await supabase
    .from("article")
    .select("language!inner (lang)", { count: "exact", head: true })
    .eq("language.lang", "zh");

  if (countError) {
    console.error("Error fetching article count:", countError);
    // 如果获取总数失败，至少返回第一页
    return [{ params: { page: "1" } }];
  }

  const totalPages = Math.ceil((count || 0) / ITEMS_PER_PAGE);

  // 生成所有页面路由
  const paths = [];
  for (let i = 1; i <= totalPages; i++) {
    paths.push({ params: { page: i.toString() } });
  }

  // 如果没有文章，至少返回第一页
  if (paths.length === 0) {
    paths.push({ params: { page: "1" } });
  }

  return paths;
}

// 获取当前页码
const { page } = Astro.params;
const currentPage = parseInt(page || "1", 10);

// 从 Supabase 获取文章数据，根据page一页输出20条数据
const from = (currentPage - 1) * ITEMS_PER_PAGE;
const to = from + ITEMS_PER_PAGE - 1;

const { data: articles, error } = await supabase
  .from("article")
  // 根据lang字段去language表查询对应的language.lang
  .select("title, published_at, language!inner (lang)")
  .eq("language.lang", "zh")
  .order("published_at", { ascending: false })
  .range(from, to);

// 获取总数（使用与主查询相同的过滤条件）
const { count: totalCount, error: countError } = await supabase
  .from("article")
  .select("language!inner (lang)", { count: "exact", head: true })
  .eq("language.lang", "zh");

if (error) {
  console.error("Error fetching articles:", error);
}

if (countError) {
  console.error("Error fetching article count:", countError);
}

const total = totalCount || 0;
const totalPages = Math.ceil(total / ITEMS_PER_PAGE);
---

<Layout>
  <HeroSection />
  <main style="padding: 2rem; max-width: 800px; margin: 0 auto;">
    <h2>文章列表</h2>
    {
      error ? (
        <p style="color: red;">获取文章失败: {error.message}</p>
      ) : articles && articles.length > 0 ? (
        <>
          <ul style="list-style: none; padding: 0;">
            {articles.map(
              (article: { title: string; published_at: string | null }) => (
                <li style="padding: 1rem; margin-bottom: 0.5rem; border-bottom: 1px solid #eee;">
                  <h3 style="margin: 0 0 0.5rem 0;">{article.title}</h3>
                  {article.published_at && (
                    <time style="color: #666; font-size: 0.9rem;">
                      {new Date(article.published_at).toLocaleDateString(
                        "zh-CN",
                      )}
                    </time>
                  )}
                </li>
              ),
            )}
          </ul>

          {/* 分页导航 */}
          {totalPages > 1 && (
            <nav style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #eee;">
              <div style="display: flex; justify-content: center; align-items: center; gap: 1rem;">
                {currentPage > 1 && (
                  <a
                    href={`/articles/${currentPage - 1}`}
                    style="padding: 0.5rem 1rem; text-decoration: none; color: #333; border: 1px solid #ddd; border-radius: 4px;"
                  >
                    上一页
                  </a>
                )}

                <span style="color: #666;">
                  第 {currentPage} 页，共 {totalPages} 页
                </span>

                {currentPage < totalPages && (
                  <a
                    href={`/articles/${currentPage + 1}`}
                    style="padding: 0.5rem 1rem; text-decoration: none; color: #333; border: 1px solid #ddd; border-radius: 4px;"
                  >
                    下一页
                  </a>
                )}
              </div>
            </nav>
          )}
        </>
      ) : (
        <p>暂无文章</p>
      )
    }
  </main>
</Layout>
