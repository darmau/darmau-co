---
import ArrowLeftIcon from "@/icons/arrow-left.astro";
import ArrowRightIcon from "@/icons/arrow-right.astro";
const { currentPage, totalPages, contextPath } = Astro.props;

// 生成页码数组
function generatePageNumbers(
  current: number,
  total: number,
): (number | string)[] {
  const pages: (number | string)[] = [];

  if (total <= 7) {
    // 如果总页数少于等于7，显示所有页码
    for (let i = 1; i <= total; i++) {
      pages.push(i);
    }
  } else {
    // 总页数较多时，显示策略：
    // 1. 始终显示第一页
    pages.push(1);

    // 2. 如果当前页离第一页较远，显示省略号
    if (current > 4) {
      pages.push("...");
    }

    // 3. 显示当前页附近的页码
    const start = Math.max(2, current - 1);
    const end = Math.min(total - 1, current + 1);

    for (let i = start; i <= end; i++) {
      if (i !== 1 && i !== total) {
        pages.push(i);
      }
    }

    // 4. 如果当前页离最后一页较远，显示省略号
    if (current < total - 3) {
      pages.push("...");
    }

    // 5. 始终显示最后一页
    pages.push(total);
  }

  return pages;
}

const pageNumbers = generatePageNumbers(currentPage, totalPages);
---

{
  totalPages > 1 && (
    <nav class="mt-8 pt-8">
      <div class="flex justify-between items-center gap-2">
        {/* 前一页按钮 */}
        {currentPage > 1 ? (
          <a
            href={`/${contextPath}/${currentPage - 1}`}
            class="px-4 py-2 text-slate-700 font-medium flex items-center gap-2"
          >
            <ArrowLeftIcon />
            <span>前一页</span>
          </a>
        ) : (
          <span class="px-4 py-2 text-slate-400 flex items-center gap-2 cursor-not-allowed">
            <ArrowLeftIcon />
            <span>前一页</span>
          </span>
        )}

        {/* 页码数字数组 */}
        <div class="flex gap-2">
          {pageNumbers.map((page) => {
            if (page === "...") {
              return <span class="px-2 py-1 text-slate-400">...</span>;
            }

            const pageNum = page as number;
            const isActive = pageNum === currentPage;

            return (
              <a
                href={`/${contextPath}/${pageNum}`}
                class={`px-2 py-1 rounded text-center transition-colors ${
                  isActive
                    ? "bg-slate-50 text-black font-medium"
                    : "text-slate-700 hover:bg-slate-50"
                }`}
              >
                {pageNum}
              </a>
            );
          })}
        </div>

        {/* 后一页按钮 */}
        {currentPage < totalPages ? (
          <a
            href={`/${contextPath}/${currentPage + 1}`}
            class="px-4 py-2 text-slate-700 font-medium flex items-center gap-2"
          >
            <span>后一页</span>
            <ArrowRightIcon />
          </a>
        ) : (
          <span class="px-4 py-2 text-slate-400 flex items-center gap-2 cursor-not-allowed">
            后一页
            <ArrowRightIcon />
          </span>
        )}
      </div>
    </nav>
  )
}
